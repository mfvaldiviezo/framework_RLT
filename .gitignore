# ==============================================================================
# Git Ignore Configuration - Traffic Project Repository
# ==============================================================================

# Python bytecode & caches
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual environments & local interpreters
.env
.venv
env/
venv/
tsc-env/
venv_pytsc/

# Testing & linting caches
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/

# Local personal documents & scratch archive
_local_archive/
*.pdf
*.zip
!tsc_framework/outputs/models/*.zip
!tsc_framework/outputs/models/**/*.zip
*.tmp
*.swp
*.bak

# Simulation runtime logs
*.log
*.sumo.log
*.sumocfg.bak

# IDE & OS metadata
.DS_Store
Thumbs.db
.vscode/
.idea/
*.sublime-project