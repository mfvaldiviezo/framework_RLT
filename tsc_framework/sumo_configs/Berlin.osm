  <tag k="description" v="Der Paul-Gerhardt-Weg führt von der Berliner Nikolaikirche zur Paul-Gerhardt-Kirche in Lübben. Er ist ein kontrastreicher Weg und der Wanderer hat dabei die Gelegenheit, eine Fülle an Naturschönheiten und historische Orte kennenzulernen."/>
  <tag k="distance" v="140"/>
  <tag k="name" v="Paul-Gerhardt-Weg"/>
  <tag k="network" v="rwn"/>
  <tag k="note" v="Der Wanderweg ist in Berlin nicht markiert. Die Markierung beginnt an der Landesgrenze nach Brandenburg"/>
  <tag k="operator" v="Tourismusverband Dahme-Seenland"/>
  <tag k="osmc:status" v="approved by BER319"/>
  <tag k="osmc:symbol" v="yellow:white:yellow_backslash"/>
  <tag k="route" v="hiking"/>
  <tag k="symbol:de" v="Weg in Linkskurve, golden, stilisiert"/>
  <tag k="type" v="superroute"/>
  <tag k="website" v="https://www.dahme-seenland.de/erlebnisse/wandern/paul-gerhardt-weg"/>
  <tag k="wikipedia" v="de:Paul-Gerhardt-Weg"/>
 </relation>
