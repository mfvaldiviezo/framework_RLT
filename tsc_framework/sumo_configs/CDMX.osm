  <tag k="description" v="La sillería es una talla de tapincerán. Tiene dos niveles de sitiales: el alto para canónigos y el bajo para seises y sochantres. En la parte superior presenta 59 relieves de obispos y santos. La sillería del coro fue realizada por Juan de Rojas en 1696."/>
  <tag k="image" v="https://mxcity.mx/wp-content/uploads/2019/04/%C3%B3rganos-catedral-metropolitana-16.jpg"/>
  <tag k="indoor" v="area"/>
  <tag k="level" v="0"/>
  <tag k="name" v="Coro"/>
 </way>
