  <tag k="access" v="no"/>
  <tag k="description" v="En el centro del coro se encuentra el facistol de maderas preciosas, tíndalo y ébano, adornado con bellas estatuillas de marfil. Esta obra de arte fue trabajada en Filipinas."/>
  <tag k="indoor" v="area"/>
  <tag k="level" v="1"/>
  <tag k="name" v="Facistol"/>
 </way>
